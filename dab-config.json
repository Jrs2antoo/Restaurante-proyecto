{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v1.2.0/dab.draft.schema.json",
  "data-source": {
    "database-type": "mysql",
    "connection-string": "Server=localhost;Port=3307;Database=proyecto2daw;User=root;Password=root;"
  },
  "runtime": {
    "rest": { "enabled": true, "path": "/api" },
    "graphql": { "enabled": true, "path": "/graphql" },
    "host": {
      "mode": "development",
      "cors": {
        "origins": ["http://localhost:5173"],
        "allow-credentials": false
      }
    }
  },
  "entities": {
    "Usuario": {
      "source": "usuario",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Cliente": {
      "source": "cliente",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Empleado": {
      "source": "empleado",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Cocinero": {
      "source": "cocinero",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Administrador": {
      "source": "administrador",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Mesa": {
      "source": "mesa",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Reserva": {
      "source": "reserva",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Producto": {
      "source": "producto",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    }
  }
}
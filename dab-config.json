{
  "$schema": "https://github.com/Azure/data-api-builder/releases/download/v1.2.0/dab.draft.schema.json",
  "data-source": {
    "database-type": "mysql",
    "connection-string": "@env('MYSQL_CONN_STRING')"
  },
  "runtime": {
    "rest": { "enabled": true, "path": "/api" },
    "graphql": { "enabled": true, "path": "/graphql" },
    "host": {
      "mode": "production",
      "cors": {
        "origins": [
          "http://localhost:5173",
          "https://restaurante-proyecto-1gn6k9gxu-jrs2antoos-projects.vercel.app"
        ],
        "allow-credentials": false
      }
    }
  },
  "entities": {
    "Usuario": {
      "source": "usuario",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Cliente": {
      "source": "cliente",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Empleado": {
      "source": "empleado",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Cocinero": {
      "source": "cocinero",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Administrador": {
      "source": "administrador",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Mesa": {
      "source": "mesa",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Reserva": {
      "source": "reserva",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    },
    "Producto": {
      "source": "producto",
      "permissions": [{ "role": "anonymous", "actions": ["*"] }]
    }
  }
}
